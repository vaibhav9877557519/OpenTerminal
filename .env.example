# OpenTerminal Configuration
# All services bind strictly to localhost (127.0.0.1) for local security.

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Frontend Web Configuration
API_URL=http://localhost:4000

# Optional: Claude AI Assistant (leave empty if not using)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Shared API Key (if omitted, auto-generated in data/.api-key)
# API_KEY=

# Optional: SEC EDGAR Contact header (User-Agent compliance)
# SEC_EDGAR_CONTACT=user@example.com
