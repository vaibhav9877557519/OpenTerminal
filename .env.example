# OpenTerminal Configuration Template
# All services bind strictly to localhost (127.0.0.1) for local security.

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Frontend Web Configuration
API_URL=http://localhost:4000

# Upstox Indian Market Data Access Token (Backend only - never exposed to browser)
UPSTOX_ACCESS_TOKEN=

# Finnhub Global & Forex Data API Key (Backend only - never exposed to browser)
FINNHUB_API_KEY=

# Optional: Claude AI Assistant (leave empty if not using)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Shared API Key (if omitted, auto-generated in data/.api-key)
# API_KEY=
